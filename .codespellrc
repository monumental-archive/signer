[codespell]
# Max enforcement: hidden files and filenames are checked, and the builtin
# dictionary set is widened beyond the default clear,rare. 'code' and
# 'names' stay off — they flag identifiers that are legitimate by design.
# Dialect dictionaries off: the house dialect is en-GB and codespell has no
# en-US->en-GB dictionary.
builtin = clear,rare,informal,usage
# Boolean flags take an EMPTY value here: any value ("true") is forwarded to
# argparse as a stray positional argument and errors.
check-hidden =
check-filenames =
# .git must lead the skip list: check-hidden would otherwise descend it (the
# lefthook remote cache under .git/info/ contains prose that isn't ours);
# .claude is machine-local session state.
skip = .git,.claude,mise.lock
# "intoto" is the in-toto attestation framework (*.intoto.jsonl bundles).
ignore-words-list = intoto
